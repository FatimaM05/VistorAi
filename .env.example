# ─── Database Connection (Supabase / Postgres) ───────────────────────────
DATABASE_URL="postgresql://postgres:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ─── Authentication (NextAuth) ──────────────────────────────────────────
NEXTAUTH_SECRET="your-32-char-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# ─── SMTP Email Configuration (Password Reset) ──────────────────────────
# Standard Gmail / SendGrid / Resend / Mailtrap / Custom SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM='"VistorAi Security" <your-email@gmail.com>'

# ─── AI Model Provider API Keys (Optional) ──────────────────────────────
# OpenAI DALL-E 3 (If absent, falls back to Pollinations.ai free engine)
OPENAI_API_KEY="sk-..."

# Replicate Video Generation (If absent, falls back to demo stream)
REPLICATE_API_TOKEN="r8_..."
REPLICATE_VIDEO_MODEL_VERSION="..."
